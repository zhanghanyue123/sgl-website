[Unit]
Description=SGL Station OS Admin connector
After=network-online.target sgl-station-os.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=/etc/sgl-station-admin-connector.env
ExecStart=/usr/bin/python3 /opt/sgl-station-admin-connector/admin_connector.py
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/sgl-station-os/data
RestrictSUIDSGID=true
LockPersonality=true
