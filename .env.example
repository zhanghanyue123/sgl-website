# Off by default. Enable only after the OPS contract and Stripe test flow pass.
STORE_CHECKOUT_ENABLED=false
NEXT_PUBLIC_STORE_CHECKOUT_ENABLED=false
SITE_URL=https://www.theseagulllabs.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ALLOW_LIVE=false
# Dedicated HTTPS store API, NOT the public admin UI or localhost.
OPS_STORE_API_URL=
OPS_STORE_API_TOKEN=

# PostgreSQL is required only for /admin and admin API routes.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=require
DATABASE_POOL_SIZE=5

# Used to hash network metadata in the append-only audit trail.
ADMIN_AUDIT_SECRET=replace-with-a-long-random-value

# One-time input for `npm run admin:create`; do not commit real values.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Store Owner
ADMIN_ROLE=owner
