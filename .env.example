# Off by default. Enable only after the OPS contract and Stripe test flow pass.
STORE_CHECKOUT_ENABLED=false
NEXT_PUBLIC_STORE_CHECKOUT_ENABLED=false
SITE_URL=https://www.theseagulllabs.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ALLOW_LIVE=false
# Dedicated HTTPS store API, NOT the public admin UI or localhost.
OPS_STORE_API_URL=
OPS_STORE_API_TOKEN=

# PostgreSQL is required only for /admin and admin API routes.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=require
DATABASE_POOL_SIZE=5
# Pending checkout stock is held for 30–1440 minutes. Default: 30.
ORDER_RESERVATION_MINUTES=30

# Used to hash network metadata in the append-only audit trail.
ADMIN_AUDIT_SECRET=replace-with-a-long-random-value

# One-time input for `npm run admin:create`; do not commit real values.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Store Owner
ADMIN_ROLE=owner

# Fries calls the dedicated Tencent Cloud OpenClaw Adapter from Vercel server
# code. It does not use Vercel AI Gateway and none of these are NEXT_PUBLIC_*.
SGL_FRIES_ADAPTER_URL=
SGL_FRIES_ADAPTER_TOKEN=
SGL_FRIES_OPENCLAW_AGENT=fries
SGL_FRIES_ADAPTER_TIMEOUT_MS=45000
SGL_FRIES_ADAPTER_MAX_ATTEMPTS=2

# SEO Growth Agent. Server-side only; leave blank to show Not Connected.
SEO_CRAWL_ALLOWED_ORIGINS=https://www.theseagulllabs.com
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=
GOOGLE_SEARCH_CONSOLE_REFRESH_TOKEN=
GOOGLE_SEARCH_CONSOLE_PROPERTY=
# Baidu Search Resource Platform does not expose a verified analytics connector
# in this application yet. The verified site is displayed as Not Connected until
# a read-only evidence provider is approved and implemented.
BAIDU_SEARCH_RESOURCE_SITE=
