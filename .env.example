# Off by default. Enable only after the OPS contract and Stripe test flow pass.
STORE_CHECKOUT_ENABLED=false
NEXT_PUBLIC_STORE_CHECKOUT_ENABLED=false
SITE_URL=https://www.theseagulllabs.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_ALLOW_LIVE=false
# Dedicated HTTPS store API, NOT the public admin UI or localhost.
OPS_STORE_API_URL=
OPS_STORE_API_TOKEN=

# PostgreSQL is required only for /admin and admin API routes.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=require
DATABASE_POOL_SIZE=5
# Pending checkout stock is held for 30–1440 minutes. Default: 30.
ORDER_RESERVATION_MINUTES=30

# Used to hash network metadata in the append-only audit trail.
ADMIN_AUDIT_SECRET=replace-with-a-long-random-value

# One-time input for `npm run admin:create`; do not commit real values.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=Store Owner
ADMIN_ROLE=owner

# Fries calls the dedicated Tencent Cloud OpenClaw Adapter from Vercel server
# code. It does not use Vercel AI Gateway and none of these are NEXT_PUBLIC_*.
SGL_FRIES_ADAPTER_URL=
SGL_FRIES_ADAPTER_HEALTH_URL=
SGL_FRIES_ADAPTER_TOKEN=
SGL_FRIES_ADAPTER_SIGNING_SECRET=
SGL_FRIES_ADAPTER_CLIENT_KEY=vercel-fries
SGL_FRIES_OPENCLAW_AGENT=fries
SGL_FRIES_ADAPTER_TIMEOUT_MS=45000
SGL_FRIES_ADAPTER_MAX_ATTEMPTS=2

# Server-only relay used by the Fries contact form when chat is unavailable.
# The relay must deliver to hello@theseagulllabs.com and return
# { "sent": true, "messageId": "..." } only after provider acceptance.
FRIES_CONTACT_DELIVERY_URL=
FRIES_CONTACT_DELIVERY_TOKEN=
FRIES_CONTACT_DELIVERY_SIGNING_SECRET=
FRIES_CONTACT_DELIVERY_CLIENT_KEY=vercel-fries-contact

# Server-only Agent Operations connector. Keep disabled until Preview mock and
# Station acceptance pass. These variables are never exposed to the browser.
FRIES_AGENT_OPS_ENABLED=false
FRIES_WEBSITE_EVENTS_URL=
FRIES_WEBSITE_EVENTS_TOKEN=
FRIES_STATION_EVENTS_URL=
FRIES_STATION_EVENTS_TOKEN=
FRIES_STATION_SIGNING_SECRET=
FRIES_STATION_CLIENT_KEY=vercel-fries-station
FRIES_WECOM_DELIVERY_URL=
FRIES_WECOM_DELIVERY_TOKEN=
FRIES_WECOM_DELIVERY_SIGNING_SECRET=
FRIES_WECOM_DELIVERY_CLIENT_KEY=vercel-fries-wecom
FRIES_WECOM_WEEKLY_DIGEST_ENABLED=false
FRIES_WECOM_WEEKLY_DIGEST_WEEKDAY=1
FRIES_WECOM_WEEKLY_DIGEST_TIME=09:00
FRIES_WECOM_WEEKLY_DIGEST_TIMEZONE=Asia/Shanghai
